# saas-identity-platform-nextjs 生产环境变量
# build-time 烘焙的 NEXT_PUBLIC_* (编进 client bundle)
# runtime 的 DATABASE_URL / JWT_* / CORS 等由 saas.env 在 VPS 注入,不走 .env.production

# MSW 关闭 → 前端走真后端 (https://saas-nextjs.xiangru.uk/api/v1/*)
# NEXT_PUBLIC_API_BASE_URL 空 → 同源 (走本仓 Next.js Route Handler)
# 真 DB 连接靠 runtime DATABASE_URL (saas.env),不在这里
NEXT_PUBLIC_ENABLE_MSW=false
NEXT_PUBLIC_API_BASE_URL=

# lab 家族 SSO (跨仓引用)
NEXT_PUBLIC_LAB_BASE_URL=https://lab-nextjs.xiangru.uk

# 自报家门
NEXT_PUBLIC_LAB_APP_CODE=lab-management