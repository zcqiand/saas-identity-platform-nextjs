# saas-identity-platform-nextjs 生产环境变量
# build-time 烘焙的 NEXT_PUBLIC_* (编进 client bundle)
# runtime 的 DATABASE_URL / JWT_* / CORS 等由 saas.env 在 VPS 注入,不走 .env.production
#
# 进仓契约文件(L0.5 门管理):真 secret 由 VPS env-file 注入,此处是 key 契约 + 占位值
# key 集合与 .env.example 完全一致(T12: key 集合拉齐)。

# NEXT_PUBLIC_API_BASE_URL 空 → 同源 (走本仓 Next.js Route Handler)
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_MODE=nextjs

# 真 DB 连接靠 runtime DATABASE_URL (saas.env),仓内只有占位
DATABASE_URL=postgresql://postgres:placeholder-vps@PROD-HOST:5432/saas_prod

# JWT signing(HS256;prod 真值由 VPS saas.env 注入)
JWT_SIGNING_KEY=placeholder-vps
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600

# Login lockout(M03.F01.I02;用 example 值)
LOCKOUT_MAX_FAILS=5
LOCKOUT_WINDOW_MIN=15
LOCKOUT_COOLDOWN_MIN=30

# OAuth 2.0(M04.F03;用 example 值)
OAUTH_CODE_TTL=600
OAUTH_REFRESH_TTL=604800

# CORS:prod 只有 saas 家族前端域名(saaS IdP 同域 nextjs 本身),无 localhost
SAAS_CORS_ALLOWED_ORIGINS=https://saas-react.xiangru.uk,https://saas-vue.xiangru.uk,https://saas-nextjs.xiangru.uk
