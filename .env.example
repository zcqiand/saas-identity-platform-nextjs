# .env.example — saas-identity-platform-nextjs 环境变量模板
# 复制为 .env 后填实际值（.env 加入 .gitignore，不进 git）。
# 三库约定见 scripts/lib/db-env.sh + ADR-0009。

# === Database（postgres-js / node-pg-migrate 格式）===
# 默认 saas_dev；SAAS_DB / DATABASE_URL 二选一覆盖。
#   SAAS_DB=saas_test npm run dev
#   DATABASE_URL=postgresql://postgres:qiand68%2B%2B%2B@100.79.128.25:5432/saas_dev npm run dev
DATABASE_URL=postgresql://postgres:qiand68%2B%2B%2B@100.79.128.25:5432/saas_dev

# === nextjs self backend base URL（默认同源，留空调自己） ===
NEXTJS_SELF_BASE_URL=

# === MSW mock 启用 ===
NEXT_PUBLIC_ENABLE_MSW=true

# === LAB base URL for OIDC redirect_uri dev shortcut（镜像 lab-springboot LAB_SAAS_BASE） ===
NEXT_PUBLIC_LAB_BASE_URL=http://localhost:3001

# === JWT signing（HS256, Phase 5 deferred；env 镜像 springboot LAB_JWT_SECRET / aspnetcore Jwt.SigningKey）===
# 当前 dev 占位 alg:none base64url；Phase 5 替换为 jose HS256 + verify。
# 路由处理器必须读本变量；未设置打 console.warn（仅 dev 路径）。
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600

# === Login lockout（M03.F01.I02）===
LOCKOUT_MAX_FAILS=5
LOCKOUT_WINDOW_MIN=15
LOCKOUT_COOLDOWN_MIN=30

# === OAuth 2.0（M04.F03.I07/I08/I09 — /oauth/authorize + /oauth/token）===
OAUTH_CODE_TTL=600
OAUTH_REFRESH_TTL=604800

# === OIDC（M03.F02.I03 — /auth/oidc/callback；dev 占位 echo code）===
OIDC_ISSUER=https://dev-idp.example.com
OIDC_CLIENT_SECRET=

# === CORS（镜像 springboot SAAS_CORS_ALLOWED_ORIGINS / aspnetcore Saas.Cors.AllowedOrigins）===
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001