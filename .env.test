# .env.test — saas-identity-platform-nextjs vitest 测试期覆盖
#
# 镜像 saas-identity-platform-{msw,aspnetcore,springboot}：四仓共享 JWT_SIGNING_KEY，
# 让 MSW 签出来的 access token 在本仓 vitest 测试期间能被 jose jwtVerify 验签通过。
# Phase 1A/1B 起 MSW 真签 HS256, dev/profile 不再走 DevJwtDecoder 兜底。

# === JWT signing (HS256, RFC 7519) ===
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600

# === Database (vitest 用 placeholder, 实际集成测试走 Testcontainers PG) ===
DATABASE_URL=postgresql://postgres:qiand68%2B%2B%2B@100.79.128.25:5432/saas_dev

# === API mode (vitest 走同源 relative URL, 触发 setupServer) ===
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_MODE=msw-http

# === saas-identity-platform 跨 origin ===
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:5101,http://localhost:5102,http://localhost:5103,http://localhost:5201

# === OAuth + Lockout ===
LOCKOUT_MAX_FAILS=5
LOCKOUT_WINDOW_MIN=15
LOCKOUT_COOLDOWN_MIN=30
OAUTH_CODE_TTL=600
OAUTH_REFRESH_TTL=604800