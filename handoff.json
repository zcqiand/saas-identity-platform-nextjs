      ]
    },
    {
      "fn_id": "M00.F05.I02",
      "tests": [
        "渲染订阅应用按钮挂 data-fn=M00.F05.I02"
      ]
    },
    {
      "fn_id": "M01.F04.I02",
      "tests": [
        "M01.F04.I02 returns 429 ACCOUNT_LOCKED after 5 consecutive failures"
      ]
    },
    {
      "fn_id": "M01.F04.I03",
      "tests": [
        "M01.F04.I03 returns 200 LoginResponse for valid credentials",
        "M01.F04.I03 returns 401 UNAUTHORIZED for wrong password",
        "M01.F04.I03 缺 clientId → 400 且不签发 token（Task 3.7 fail-fast，TSP LoginRequest.clientId required）",
        "M01.F04.I03 returns 400 BAD_REQUEST for invalid body",
        "渲染登录表单，挂 data-fn=M01.F04.I03 的提交按钮",
        "邀请按钮挂 data-fn=M01.F04.I03"
      ]
    },
    {
      "fn_id": "M01.F04.I06",
      "tests": [
        "M01.F04.I06 returns 204 with valid Authorization header",
        "M01.F04.I06 returns 204 even with invalid Authorization header",
        "M01.F04.I06 returns 204 with no Authorization header"
      ]
    },
    {
      "fn_id": "M04",
      "tests": [
        "一级分组恰好是两个功能模块：租户管理（M00）、应用管理（M04）"
      ]
    },
    {
      "fn_id": "M04.F03.I01",
      "tests": [
        "M04.F03.I01 Bearer + 登录页形状（无 tenantId）→ 200 { code, state }，code 落 oauth_code 表",
        "M04.F03.I01 body 多带 tenantId（contract-test/lab 消费端形状）→ 200，body tenantId 被忽略不拒收",
        "M04.F03.I01 白名单前缀 + '?query' 边界 → 200（RFC 6749 §3.1.2，lab 回跳带 ?from）",
        "M04.F03.I01 无 Authorization → 401 UNAUTHORIZED（禁匿名签 code）",
        "M04.F03.I01 坏 Bearer → 401 UNAUTHORIZED",
        "M04.F03.I01 Bearer 缺 tenant_id claim → 401（tenant 必须来自认证身份，不信 body）",
        "M04.F03.I01 Bearer sub 不在 sys_user → 401（msw oracle『session user not found』同款）",
        "M04.F03.I01 缺必填字段 → 400 INVALID_REQUEST",
        "M04.F03.I01 responseType != 'code' → 400 UNSUPPORTED_RESPONSE_TYPE",
        "M04.F03.I01 clientId 未注册 → 400 INVALID_CLIENT",
        "M04.F03.I01 redirectUri 不在白名单 → 400 INVALID_REDIRECT_URI",
        "M04.F03.I01 白名单条目的子路径（无 '?' 边界）→ 400 INVALID_REDIRECT_URI（csv 语义，非子串匹配）"
      ]
    },
    {
      "fn_id": "M04.F03.I02",
      "tests": [
        "M04.F03.I02 returns 200 TokenResponse for valid authorization_code（无 body tenantId）",
        "M04.F03.I02 body 多带 tenantId（错值）→ 仍 200（tenantId 非契约字段，取 code 行绑定值）",
        "M04.F03.I02 returns 400 INVALID_GRANT when code unknown",
        "M04.F03.I02 code 过期 → 400 INVALID_GRANT 且删行",
        "M04.F03.I02 redirectUri 与 authorize 时不一致 → 400 INVALID_GRANT（RFC 6749 §4.1.3）",
        "M04.F03.I02 returns 400 INVALID_CLIENT when clientId unknown",
        "M04.F03.I02 returns 400 UNSUPPORTED_GRANT_TYPE for unknown grant"
      ]
    },
    {
      "fn_id": "M04.F03.I03",
      "tests": [
        "M04.F03.I03 returns 200 rotated TokenResponse for valid refresh_token",
        "M04.F03.I03 returns 400 INVALID_GRANT when refreshToken unknown"
      ]
    }
  ],
