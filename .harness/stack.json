{
  "schema": 1,
  "project": "saas-identity-platform-nextjs",
  "stack": "nextjs",
  "suite_version": "0.6.0",
  "source_dirs": ["src", "app"],
  "test_dirs": ["tests"],
  "gates": {
    "L1": { "name": "格式", "cmd": ["npx", "--no", "prettier", "--check", "src", "app", "tests"], "fix": "npx prettier --write src app tests" },
    "L2": { "name": "静态检查", "cmd": ["npx", "--no", "eslint", "src", "app", "tests"], "fix": "逐条修复 eslint" },
    "L3": { "name": "类型", "cmd": ["npx", "--no", "tsc", "--noEmit"], "fix": "补全类型" },
    "L4": { "name": "测试", "cmd": ["npx", "--no", "vitest", "run"], "fix": "先让测试变绿" }
  },
  "trace_cmd": ["npx", "--no", "vitest", "run"],
  "trace_env": { "TRACE_MAP": "1" }
}